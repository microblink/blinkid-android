  <string name="mb_blinkid_onboarding_dialog_barcode_id_message">Turli ID hujjatlarida shtrix-kod formatlari va joylari ham har xil boʻlishi mumkin. Shtrix-kodni ID hujjatning old va orqa tomonidan qidiring.</string>
